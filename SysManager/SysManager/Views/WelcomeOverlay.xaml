<UserControl x:Class="SysManager.Views.WelcomeOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="WelcomeOverlay"
             AutomationProperties.Name="Welcome to SysManager"
             AutomationProperties.IsDialog="True"
             KeyboardNavigation.TabNavigation="Cycle">

    <!-- The one-time Welcome screen (#1635), over the whole window the first time SysManager starts on a PC.
         The app used to open straight onto the Dashboard's live sensors, and nothing on screen said what it is or
         that it is safe.

         A UserControl rather than a bare Border because a Border has no automation peer, so IsDialog and the
         name above would reach no screen reader. TabNavigation=Cycle keeps Tab on the three buttons; the shell
         disables the sidebar and the page behind while this is up, so nothing else could take focus anyway, and
         its KeyDown handler gives Escape to WelcomeViewModel.KeyCommand and no key to anything behind.

         The scrim takes every click outside the card and does nothing with it: a click beside a dialog that closes
         it is a way to lose it before reading it. The card is a Card like every other surface. Its shadow is drawn
         by a separate Border behind it, because an Effect on the element that holds the text renders that text
         without ClearType. -->
    <Grid Background="{DynamicResource Scrim}">
        <!-- Scrolls only if the window is too short for the card, which a 640px-tall window is not. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Width="600" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border CornerRadius="{StaticResource RadiusLg}" Background="{DynamicResource Surface1}">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="8" BlurRadius="32" Opacity="0.6" Color="Black"/>
                    </Border.Effect>
                </Border>

                <Border Style="{StaticResource Card}" Padding="28,24,28,24">
                    <StackPanel>
                        <TextBlock Text="Welcome to SysManager" Style="{StaticResource Heading}"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="A local-first tool for keeping an eye on this PC: what is slowing it down, what is filling it up, and what is changing it."/>

                        <!-- The three points: the same 30px circle and 12px gap as the rows of Undo Changes and
                             Recent Changes, with the glyph in its status colour. -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                    Background="{DynamicResource Surface3}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Success}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Everything stays on this PC" Style="{StaticResource SectionTitle}"/>
                                <!-- The short form of SECURITY.md's "When the app uses the network", and the same
                                     words as the About tab's Legal card. ArchitectureTests holds every count of
                                     the checks at startup to the one in SECURITY.md. -->
                                <TextBlock x:Name="NetworkPromise" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="No account, no cloud, no tracking. SysManager goes online only for what you ask it to do, plus two checks when it starts: it asks GitHub whether a newer version is out, at most once a day, and it asks winget, Microsoft's app installer, which of your apps have updates. It adds nothing about you to either, and you can switch either off in About."/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                    Background="{DynamicResource Surface3}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Warning}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Nothing changes unless you ask" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="SysManager changes your PC only when you tell it to, and every tab that deletes files or removes apps asks you first. Some tools also make a restore point before they change Windows, and many changes can be put back, one at a time, from Undo Changes."/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                    Background="{DynamicResource Surface3}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource Info}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Every tab explains itself" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Text="Each page says under its title what it is for. A page that needs administrator rights says so at the top, and what it can do once SysManager runs as administrator."/>
                            </StackPanel>
                        </Grid>

                        <!-- One primary, the safest first step; the second a secondary; the way out a ghost. Three
                             purple buttons would tell the reader nothing about where to start. -->
                        <DockPanel Margin="0,22,0,0" LastChildFill="False">
                            <Button x:Name="CheckHealthButton"
                                    Content="Check my PC's health"
                                    Command="{Binding CheckHealthCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.AutomationId="WelcomeCheckHealth"
                                    AutomationProperties.Name="Check my PC's health — open System Health"/>
                            <Button Content="Clean up junk files"
                                    Command="{Binding CleanUpCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0"
                                    AutomationProperties.AutomationId="WelcomeCleanUp"
                                    AutomationProperties.Name="Clean up junk files — open Quick Cleanup"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Just look around"
                                    Command="{Binding LookAroundCommand}"
                                    Style="{StaticResource GhostButton}"
                                    AutomationProperties.AutomationId="WelcomeLookAround"
                                    AutomationProperties.Name="Just look around — close this and stay on this page"/>
                        </DockPanel>
                        <TextBlock Text="Shown once. Esc, or any of the three buttons, closes it for good."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
