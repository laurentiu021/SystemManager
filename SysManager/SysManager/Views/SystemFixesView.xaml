<UserControl x:Class="SysManager.Views.SystemFixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysManager.ViewModels"
             xmlns:v="clr-namespace:SysManager.Views"
             d:DataContext="{d:DesignInstance vm:SystemFixesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0}">

    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="System Fixes" Style="{StaticResource Display}"/>
            <TextBlock Text="One-click repairs for common Windows breakages. Each fix explains what it does and asks for confirmation before it runs. These change system state and need administrator rights."
                       Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Elevation banner -->
        <v:AdminBanner Grid.Row="1" Margin="0,0,0,12"
                       NotElevatedMessage="These repairs modify system services and settings, so they require administrator privileges."
                       ElevatedMessage="Running as administrator — all repairs are available."/>

        <!-- Fix cards -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <!-- Two sections, split by whether the fix needs administrator rights. The elevation
                     banner above speaks for the first one; the second runs as the user, and saying so
                     next to the buttons is what stops a user without admin assuming nothing here works.
                     SectionTitle + Subtle description is the same shape Quick Cleanup uses. -->
                <TextBlock Text="Repair Windows itself" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Text="These change system files, services or settings, so they need administrator rights. The first two are the ones to reach for when you do not yet know what broke."
                           Style="{StaticResource Subtle}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <!-- The two general-purpose repairs first: they are what fixes an unexplained
                     misbehaving Windows, and the targeted ones below only help if you already know
                     what broke. Moved here from Quick Cleanup, whose name promised housekeeping
                     while hosting a 15-minute system repair (#1493). -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Repair damaged Windows files (SFC)" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Checks every protected Windows file against Windows' own known-good copy and replaces the damaged ones. Takes 5–15 minutes and runs in the background — you can keep using the app."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run" Command="{Binding RunSfcCommand}"
                            AutomationProperties.AutomationId="btn-fixes-sfc"
                            AutomationProperties.Name="Run — repair damaged Windows files with SFC"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Repair Windows' own repair source (DISM)" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Rebuilds the store of known-good copies that the repair above draws from, downloading replacements through Windows Update. Run this first if SFC reports files it could not fix. Takes 10–30 minutes."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run" Command="{Binding RunDismCommand}"
                            AutomationProperties.AutomationId="btn-fixes-dism"
                            AutomationProperties.Name="Run — repair the Windows component store with DISM"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Reset Windows Update" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Stop the update services, clear their caches, and restart them — fixes most stuck-update problems."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run" Command="{Binding ResetWindowsUpdateCommand}"
                            AutomationProperties.Name="Run — reset Windows Update"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Reinstall WinGet" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Re-register the Windows Package Manager (App Installer) when app installs or uninstalls fail."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Run" Command="{Binding ReinstallWinGetCommand}"
                            AutomationProperties.Name="Run — reinstall WinGet"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <!-- Live indicators for the two long repairs. A repair that grinds for half an hour has
                     to say WHICH one is running, which is why these are bound to per-repair flags rather
                     than to IsBusy. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding IsSfcRunning, Converter={StaticResource FlexVis}}">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource Success}"/>
                    <TextBlock Text="Repairing Windows files — " Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SfcStatus}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SfcEtaText}" Foreground="{DynamicResource TextMuted}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding SfcEtaText, Converter={StaticResource FlexVis}}"/>
                </StackPanel>
                <!-- SFC verdict (shown after completion) -->
                <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="{StaticResource RadiusMd}"
                        Background="{DynamicResource Surface1}"
                        Visibility="{Binding SfcVerdict, Converter={StaticResource FlexVis}}">
                    <!-- DockPanel, not a horizontal StackPanel: inside one, a child's TextWrapping is
                         inert — it is measured with infinite width, so long verdicts were clipped
                         rather than wrapped. -->
                    <DockPanel>
                        <TextBlock Text="SFC result:" DockPanel.Dock="Left" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Announced: an SFC repair runs for many minutes with the window in the
                             background, and this is the sentence that says how it ended. The "Repairing
                             Windows files" label above is static text, so a live region could not
                             announce it even if it carried one — what changes there is visibility, not
                             content. Start and progress are covered by the status line at the bottom. -->
                        <TextBlock Text="{Binding SfcVerdict}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{Binding SfcVerdictColorHex, Converter={StaticResource HexBrush}}"/>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding IsDismRunning, Converter={StaticResource FlexVis}}">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource Info}"/>
                    <TextBlock Text="Repairing the component store — " Foreground="{DynamicResource Info}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DismStatus}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DismEtaText}" Foreground="{DynamicResource TextMuted}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding DismEtaText, Converter={StaticResource FlexVis}}"/>
                </StackPanel>
                <!-- DISM verdict (shown after completion) -->
                <Border Margin="0,8,0,0" Padding="12,10" CornerRadius="{StaticResource RadiusMd}"
                        Background="{DynamicResource Surface1}"
                        Visibility="{Binding DismVerdict, Converter={StaticResource FlexVis}}">
                    <!-- DockPanel for the same reason as the SFC verdict above. -->
                    <DockPanel>
                        <TextBlock Text="DISM result:" DockPanel.Dock="Left" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DismVerdict}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{Binding DismVerdictColorHex, Converter={StaticResource HexBrush}}"/>
                    </DockPanel>
                </Border>

                <TextBlock Text="Fix the desktop and taskbar" Style="{StaticResource SectionTitle}" Margin="0,14,0,4"/>
                <TextBlock Text="No administrator rights needed — these restart your own desktop, and they are the quickest things to try first. Both close any open File Explorer windows; the taskbar and desktop come back on their own within a few seconds."
                           Style="{StaticResource Subtle}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Restart Windows Explorer" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="For a taskbar that has stopped responding, a Start menu that will not open, or a desktop with no icons. Ends the desktop and brings it straight back."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restart" Command="{Binding RestartExplorerCommand}"
                            AutomationProperties.AutomationId="btn-fixes-restart-explorer"
                            AutomationProperties.Name="Restart — restart Windows Explorer"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Rebuild icon &amp; thumbnail cache" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="For icons or picture previews that come up blank, wrong, or as a plain white page. Clears the cache Windows keeps of them and lets it build a fresh one as you browse."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Rebuild" Command="{Binding RebuildIconCacheCommand}"
                            AutomationProperties.AutomationId="btn-fixes-rebuild-icon-cache"
                            AutomationProperties.Name="Rebuild — rebuild the icon and thumbnail cache"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <TextBlock Text="Sign-in" Style="{StaticResource SectionTitle}" Margin="0,14,0,4"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Set up Auto Sign-in" FontWeight="SemiBold" Style="{StaticResource Body}" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Opens the built-in User Accounts dialog to enable automatic sign-in. Windows stores the credential securely — SysManager never sees your password."
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open" Command="{Binding OpenAutologinCommand}"
                            AutomationProperties.Name="Open auto sign-in settings"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Center" MinWidth="80"/>
                </Grid>

                <TextBlock Margin="0,12,0,0" Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="Looking to reset the network stack (Winsock / TCP-IP / DNS flush)? Use the Network → Network Repair tab, which provides those as individual one-click tools."/>
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                           Text="Just short of disk space? Cleaning up temporary files and old Windows update files is on the Cleanup → Quick Cleanup tab."/>
            </StackPanel>
        </Border>

        <!-- Output console — shared ConsoleView (same control the other repair/scan tabs use) -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <v:ConsoleView DataContext="{Binding Console}"/>
        </Border>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <!-- Value as well as IsIndeterminate: SFC and DISM report a real percentage, and a marquee
                 bar would throw that away. IsProgressIndeterminate is false for exactly those two once
                 their first percentage lands. -->
            <ProgressBar AutomationProperties.Name="System repair progress" DockPanel.Dock="Left" Width="120" Height="4" Margin="0,0,12,0"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Value="{Binding Progress}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel current repair"
                    Style="{StaticResource GhostButton}" Margin="0,0,12,0" Padding="10,2"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusLine}"/>
        </DockPanel>
    </Grid>
</UserControl>
