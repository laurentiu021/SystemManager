<UserControl x:Class="SysManager.Views.RecentChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysManager.ViewModels"
             xmlns:v="clr-namespace:SysManager.Views"
             d:DataContext="{d:DesignInstance vm:RecentChangesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Recent Changes (#1507): what changed on this PC lately, from every source that knows, one day at a time. A long
         page that scrolls as one unit, so the scrolling-page layout, as Undo Changes uses. Read-only: the only buttons
         open the tab that can do something about a change. -->
    <Grid Background="{DynamicResource Surface0}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">

                <!-- Header -->
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"
                                AutomationProperties.Name="Refresh the list of recent changes"
                                ToolTip="Look again at what changed (F5)."/>
                        <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="6,0,0,0" AutomationProperties.Name="Export CSV — the changes shown"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Recent Changes" Style="{StaticResource Display}"/>
                        <TextBlock Text="What changed on this PC lately, and who changed it: you in SysManager, Windows, or another program. Read-only — nothing here changes anything."
                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- What to show -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="12">
                    <WrapPanel>
                        <TextBlock Text="Show" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="All" GroupName="ChangeCategory" Margin="0,0,4,0"
                                     AutomationProperties.Name="All — every kind of change"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource IsEqual}, ConverterParameter='All'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="SysManager" GroupName="ChangeCategory" Margin="0,0,4,0"
                                     AutomationProperties.Name="SysManager — what you did in SysManager"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource IsEqual}, ConverterParameter='SysManager'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="Windows" GroupName="ChangeCategory" Margin="0,0,4,0"
                                     AutomationProperties.Name="Windows — updates Windows installed or could not install"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource IsEqual}, ConverterParameter='Windows'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="Programs" GroupName="ChangeCategory" Margin="0,0,4,0"
                                     AutomationProperties.Name="Programs — programs installed, updated or removed"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource IsEqual}, ConverterParameter='Programs'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="Settings" GroupName="ChangeCategory" Margin="0,0,18,0"
                                     AutomationProperties.Name="Settings — settings changed from the ones you saved"
                                     IsChecked="{Binding SelectedCategory, Converter={StaticResource IsEqual}, ConverterParameter='Settings'}"
                                     Style="{StaticResource FilterChipNeutral}"/>

                        <TextBlock Text="Period" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton Content="7 days" GroupName="ChangePeriod" Margin="0,0,4,0"
                                     AutomationProperties.Name="7 days — period: the last 7 days"
                                     IsChecked="{Binding SelectedPeriod, Converter={StaticResource IsEqual}, ConverterParameter='7 days'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="30 days" GroupName="ChangePeriod" Margin="0,0,4,0"
                                     AutomationProperties.Name="30 days — period: the last 30 days"
                                     IsChecked="{Binding SelectedPeriod, Converter={StaticResource IsEqual}, ConverterParameter='30 days'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                        <RadioButton Content="90 days" GroupName="ChangePeriod"
                                     AutomationProperties.Name="90 days — period: the last 90 days"
                                     IsChecked="{Binding SelectedPeriod, Converter={StaticResource IsEqual}, ConverterParameter='90 days'}"
                                     Style="{StaticResource FilterChipNeutral}"/>
                    </WrapPanel>
                </Border>

                <!-- What the period held, and what could not be read -->
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Subtle}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Summary, Converter={StaticResource FlexVis}}"/>
                <TextBlock Text="{Binding Notes}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasNotes, Converter={StaticResource FlexVis}}"/>

                <!-- One card per day, newest first -->
                <ItemsControl ItemsSource="{Binding Days}" Focusable="False"
                              AutomationProperties.Name="Recent changes, by day"
                              Visibility="{Binding HasChanges, Converter={StaticResource FlexVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SectionTitle}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ListRowBorder}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Subtle}"
                                                                   VerticalAlignment="Top" Margin="0,6,0,0"/>

                                                        <Border Grid.Column="1" Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                                                Background="{DynamicResource Surface3}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                                       FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Who}" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Detail, Converter={StaticResource FlexVis}}"/>
                                                            <Button Content="{Binding ExpandText}" Command="{Binding ToggleCommand}"
                                                                    Style="{StaticResource GhostButton}" Padding="8,2" Margin="0,6,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    AutomationProperties.Name="{Binding ExpandName}"
                                                                    Visibility="{Binding HasItems, Converter={StaticResource FlexVis}}"/>
                                                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0" Focusable="False"
                                                                          Visibility="{Binding IsExpanded, Converter={StaticResource FlexVis}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}"
                                                                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <Button Grid.Column="3" Content="{Binding LinkText}"
                                                                Command="{Binding DataContext.OpenTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding LinkNavId}"
                                                                Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{Binding LinkName}"
                                                                Visibility="{Binding HasLink, Converter={StaticResource FlexVis}}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Problems are not changes: counted, and left to System Logs -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding HasProblems, Converter={StaticResource FlexVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open System Logs"
                                Command="{Binding OpenTabCommand}" CommandParameter="nav-logs"
                                AutomationProperties.Name="Open System Logs"
                                Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding ProblemsText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource FlexVis}}">
                    <v:EmptyState Glyph="&#xE73E;" Title="{Binding EmptyTitle}" Message="{Binding EmptyMessage}"/>
                </Border>

                <v:StatusFooter Margin="0,16,0,0" ProgressName="Recent Changes progress"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
