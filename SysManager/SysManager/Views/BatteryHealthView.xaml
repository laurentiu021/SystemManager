<UserControl x:Class="SysManager.Views.BatteryHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:v="clr-namespace:SysManager.Views"
             xmlns:vm="clr-namespace:SysManager.ViewModels"
             d:DataContext="{d:DesignInstance vm:BatteryHealthViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface0}">

    <UserControl.Resources>
        <!-- The wear verdict callout. Styled exactly as Speed Test's SpeedVerdictTemplate, which follows the Ping
             tab's health verdict: colour dot, SemiBold headline in the verdict's own colour, the detail stacked
             under it so it wraps instead of being clipped (#1807). A verdict here answers the same kind of question,
             so it should not look like an unrelated feature. -->
        <DataTemplate x:Key="WearVerdictTemplate">
            <Border Style="{StaticResource CardInner}" Margin="0,12,0,0" Padding="12,10"
                    BorderBrush="{Binding ColorKey, Converter={StaticResource HexBrush}}"
                    BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{Binding ColorKey, Converter={StaticResource HexBrush}}"/>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding ColorKey, Converter={StaticResource HexBrush}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}"
                               Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="18,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Battery Health" Style="{StaticResource Display}"/>
            <TextBlock Text="Monitor battery charge, health, wear level, cycle count, and estimated runtime."
                       Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
            <WrapPanel>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            </WrapPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Style="{StaticResource Body}"/>
        </Border>

        <!-- Battery details -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- No battery message, or that the battery could not be read (#2503) -->
                    <TextBlock Text="{Binding NoBatteryText}"
                               FontSize="14" Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,16"
                               Visibility="{Binding Battery.HasBattery, Converter={StaticResource FlexVis}, ConverterParameter=Inverse}"/>

                    <!-- Battery cards (visible only when battery exists) -->
                    <StackPanel Visibility="{Binding Battery.HasBattery, Converter={StaticResource BoolToVis}}">

                        <!-- Charge — label-above-value layout so the big number sits flush-left
                             at the same x as the Health/Wear values below, instead of indented. -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Charge" Style="{StaticResource Subtle}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource MetricLarge}" FontWeight="Bold">
                                        <Run Text="{Binding Battery.ChargePercent, Mode=OneWay}"/><Run Text="%"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Battery.Status}" VerticalAlignment="Center"
                                               Margin="12,0,0,0" Style="{StaticResource Subtle}"/>
                                </StackPanel>

                                <ProgressBar AutomationProperties.Name="Battery charge level"
                                             Value="{Binding Battery.ChargePercent}" Maximum="100"
                                             Height="8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Health & Wear -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Health" Style="{StaticResource Subtle}" FontSize="12"/>
                                    <TextBlock Text="{Binding Battery.HealthDisplay, Mode=OneWay}"
                                               Style="{StaticResource Metric}" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Wear" Style="{StaticResource Subtle}" FontSize="12"/>
                                    <!-- Danger red only when a real wear figure exists; "Not available"
                                         is missing data, not a warning. -->
                                    <TextBlock Text="{Binding Battery.WearDisplay, Mode=OneWay}"
                                               FontWeight="Bold" Margin="0,4,0,0">
                                        <!-- The rung comes through BasedOn rather than a Style attribute:
                                             this element already owns an inline Style for the wear-colour
                                             trigger, and Style can only be set once. -->
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Metric}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Battery.HasCapacityData, Mode=OneWay}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Why the figures are missing. Capacity comes from root\WMI, which needs
                             elevation; without it the app previously showed "-1%" as if it were a
                             measurement. Explains the gap and what unlocks it, consistent with how
                             other tabs describe their admin requirement. -->
                        <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding Battery.HasCapacityData, Converter={StaticResource FlexVis}, ConverterParameter=Inverse, Mode=OneWay}">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}"
                                       Text="Battery health and wear could not be read. SysManager reads them, and the design capacity, full charge capacity and cycle count below, from a part of Windows that only answers an elevated process, so they need it to be running as administrator. The rest of the page, including the capacity history, works without it."/>
                        </Border>

                        <!-- Capacity over time (#1513). "Health 87%" alone cannot be read as fine or failing; how much
                             it lost over the last months can. Drawn from the history Windows keeps in its battery report,
                             so there are months to show on the first visit and no administrator is needed. -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Capacity over time" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="How much charge this battery holds when full, compared with when it was new, from the history Windows keeps of it."
                                           Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                <ContentControl Content="{Binding WearVerdict}"
                                                ContentTemplate="{StaticResource WearVerdictTemplate}"
                                                Visibility="{Binding WearVerdict, Converter={StaticResource FlexVis}}"/>

                                <Border Style="{StaticResource CardInner}" Margin="0,8,0,0" Padding="10,8"
                                        Visibility="{Binding CapacityChart.HasChart, Converter={StaticResource FlexVis}}">
                                    <StackPanel>
                                        <lvc:CartesianChart Height="150" Background="Transparent"
                                                            AutomationProperties.Name="Battery capacity over time"
                                                            Series="{Binding CapacityChart.Series}"
                                                            XAxes="{Binding CapacityChart.XAxes}" YAxes="{Binding CapacityChart.YAxes}"
                                                            LegendPosition="Top"
                                                            LegendTextPaint="{Binding CapacityChart.LegendTextPaint}"
                                                            LegendBackgroundPaint="{Binding CapacityChart.LegendBackgroundPaint}"
                                                            TooltipTextPaint="{Binding CapacityChart.TooltipTextPaint}"
                                                            TooltipBackgroundPaint="{Binding CapacityChart.TooltipBackgroundPaint}"/>
                                        <TextBlock Text="From Windows' battery report: a point a week, and a point a day for the last few days."
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardInner}" Margin="0,8,0,0" Padding="0"
                                        Visibility="{Binding HistoryTooShort, Converter={StaticResource FlexVis}}">
                                    <v:EmptyState Glyph="&#xE9D9;" Title="Not enough history yet"
                                                  Message="{Binding HistoryTooShort}"/>
                                </Border>

                                <!-- Reading, not kept by Windows, or not readable: one line rather than an empty chart. -->
                                <TextBlock Text="{Binding HistoryNote}" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding HistoryNote, Converter={StaticResource FlexVis}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Details grid -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Battery name"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Battery.Name}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Chemistry"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Battery.Chemistry}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Design capacity"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                                    <Run Text="{Binding Battery.DesignCapacityMWh, Mode=OneWay}"/><Run Text=" mWh"/>
                                </TextBlock>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Full charge capacity"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <Run Text="{Binding Battery.FullChargeCapacityMWh, Mode=OneWay}"/><Run Text=" mWh"/>
                                </TextBlock>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Cycle count"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Battery.CycleCount}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Estimated runtime"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Battery.RuntimeDisplay}"
                                           Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Device ID"
                                           Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Battery.Manufacturer}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <v:StatusFooter Grid.Row="4" Margin="0,8,0,0" ProgressName="Refresh progress"/>
    </Grid>
</UserControl>
