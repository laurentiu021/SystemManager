<UserControl x:Class="SysManager.Views.UndoChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SysManager.Helpers"
             xmlns:vm="clr-namespace:SysManager.ViewModels"
             xmlns:v="clr-namespace:SysManager.Views"
             d:DataContext="{d:DesignInstance vm:UndoChangesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Undo Changes (#1525): one page for every change SysManager can put back. A long page that scrolls as one
         unit, so the scrolling-page layout — the same as System Health. -->
    <Grid Background="{DynamicResource Surface0}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">

                <!-- Header -->
                <DockPanel>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"
                            AutomationProperties.Name="Refresh the changes SysManager can put back"
                            ToolTip="Check again for changes that can be put back (F5)."
                            HorizontalAlignment="Right" VerticalAlignment="Top" DockPanel.Dock="Right"/>
                    <StackPanel>
                        <TextBlock Text="Undo Changes" Style="{StaticResource Display}"/>
                        <TextBlock Text="Put back a change SysManager made, one at a time. Each one asks first and says what it will change. To roll the whole PC back to before a session, use Restore Points."
                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <!-- Elevation banner -->
                <v:AdminBanner Margin="0,12,0,0"
                               NotElevatedMessage="Some changes need administrator rights to go back. Their rows are marked, and they can be put back once SysManager runs as administrator; the rest can be put back now."
                               ElevatedMessage="Running as administrator — every change listed here can be put back, and the newest restore point is shown."/>

                <!-- What SysManager kept a copy of -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Changes SysManager can put back" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="A row goes away once it has been put back."
                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding Changes}" helpers:RebuildFocus.Keep="True" Margin="0,10,0,0" Focusable="False"
                                      AutomationProperties.Name="Changes SysManager can put back"
                                      Visibility="{Binding HasChanges, Converter={StaticResource FlexVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                                    Background="{DynamicResource Surface3}" Margin="0,0,12,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{DynamicResource TextSecondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Body}"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Amber, the admin colour: this row needs administrator rights. -->
                                                    <Border CornerRadius="{StaticResource RadiusPill}" Padding="7,1" Margin="8,0,0,0"
                                                            BorderThickness="1" BorderBrush="{DynamicResource WarningBg}"
                                                            Background="{DynamicResource WarningBgSubtle}" VerticalAlignment="Center"
                                                            Visibility="{Binding NeedsAdmin, Converter={StaticResource FlexVis}}">
                                                        <TextBlock Text="Needs administrator" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningText}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Caption, Converter={StaticResource FlexVis}}"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="{Binding ActionText}"
                                                    Command="{Binding DataContext.PutBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding ButtonName}"
                                                    AutomationProperties.HelpText="{Binding ButtonHint}"
                                                    ToolTip="{Binding ButtonHint}"
                                                    ToolTipService.ShowOnDisabled="True"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <v:EmptyState Glyph="&#xE7A7;"
                                      Title="{Binding EmptyTitle}"
                                      Message="{Binding EmptyMessage}"
                                      Visibility="{Binding ShowNothingToPutBack, Converter={StaticResource FlexVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Tabs whose switches are their own undo -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Switches that are their own undo" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="These tabs show what is on right now, and turning a switch back is how you undo it. SysManager does not list them above, because it cannot tell its change from one that was already so."
                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding Switches}" Margin="0,10,0,0" Focusable="False"
                                      AutomationProperties.Name="Tabs whose switches are their own undo">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,12,6">
                                        <Button DockPanel.Dock="Right" Content="Open"
                                                Command="{Binding DataContext.OpenTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding NavId}"
                                                AutomationProperties.Name="{Binding ButtonName}"
                                                Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="12,0,0,0"/>
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <Run Text="—"/>
                                            <Run Text="{Binding What, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The whole PC at once -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="The whole PC at once" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="When SysManager runs as administrator, its first change in a session on Privacy &amp; Telemetry, Preinstalled Apps, Defender Tweaks or a few other tabs asks Windows for a restore point first. Going back to it undoes every system change since — settings, drivers, programs installed after it — not just one, and restarts the PC. It does not bring back removed preinstalled apps, and it leaves your files alone."
                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Open Restore Points"
                                    Command="{Binding OpenTabCommand}" CommandParameter="nav-restore-points"
                                    AutomationProperties.Name="Open Restore Points"
                                    Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding RestorePointText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Said plainly, so nobody counts on a way back that is not there -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="What cannot be put back" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="• Files that were deleted for good, and anything File Shredder removed. Files sent to the Recycle Bin can be put back from the Recycle Bin."/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="• Preinstalled apps that were removed — most can be reinstalled from the Microsoft Store; ones Microsoft has retired, such as Skype, cannot."/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="• Programs removed with the Uninstaller — reinstall them."/>
                    </StackPanel>
                </Border>

                <v:StatusFooter Margin="0,16,0,0" ProgressName="Undo Changes progress"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
