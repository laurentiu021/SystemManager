<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyName>SysManager</AssemblyName>
    <RootNamespace>SysManager</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The documentation file exists for the compiler's checks; it is not part of what ships. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <!-- The release publishes a single file, which turns on the SDK's single-file analyzer (IL3000 to IL3003:
         Assembly.Location and the APIs marked RequiresAssemblyFiles). Set here, every build runs it, so a pull
         request fails on what would otherwise fail only the release, after its tag exists (#2806). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <Version>1.136.150</Version>
    <FileVersion>1.136.150.0</FileVersion>
    <AssemblyVersion>1.136.150.0</AssemblyVersion>
    <Product>SysManager</Product>
    <Description>SysManager — Windows system monitoring toolkit by laurentiu021. Network, updates, health, logs, safe deep cleanup.</Description>
    <PackageProjectUrl>https://github.com/laurentiu021/SystemManager</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\ctx-win10-default.png" />
    <Resource Include="Resources\ctx-win10-custom-max.png" />
    <Resource Include="Resources\ctx-win11-default.png" />
    <Resource Include="Resources\ctx-win11-custom-max.png" />
    <Resource Include="Resources\ctx-win11-show-more.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\ProcessDescriptions.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <!-- The chart's WPF view brings these three in, and each ships only .NET Framework assets, which NuGet uses with
         warning NU1701. They are referenced here so the warning is waived for them alone: a project-wide NoWarn
         waived it, and NU1603, for every package, so the next one would have reached the release unseen (#2858). -->
    <PackageReference Include="OpenTK" NoWarn="NU1701" />
    <PackageReference Include="OpenTK.GLWpfControl" NoWarn="NU1701" />
    <PackageReference Include="SkiaSharp.Views.WPF" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="NvAPIWrapper.Net" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Management.Automation" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

</Project>
